generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// l'URL de connexion est dans prisma.config.ts
datasource db {
  provider = "postgresql"
}

// ---------- Site ----------
enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}

model User {
  id        String            @id // ID Discord
  username  String
  avatar    String?
  role      UserRole          @default(MEMBER) // rôle sur le forum
  createdAt DateTime          @default(now())
  threads   ForumThread[]
  posts     ForumPost[]
  uploads   ForumAttachment[]
}

// ---------- Guildes ----------
model Guild {
  id             String          @id // ID Discord de la guilde
  name           String
  icon           String? // hash de l'icône Discord, pour le classement public
  caseCounter    Int             @default(0)
  ticketCounter  Int             @default(0)
  joinedAt       DateTime        @default(now())
  leftAt         DateTime? // rempli par guildDelete
  config         GuildConfig?
  cases          Case[]
  levels         MemberLevel[]
  marriages      Marriage[]
  tickets        Ticket[]
  ticketPanel    TicketPanel?
  giveaways      Giveaway[]
  rolePanels     RolePanel[]
  td2Events      Td2Event[]
  td2Reports     Td2Report[]
  guildDelegates GuildDelegate[]
}

model GuildConfig {
  guildId                String   @id
  guild                  Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  timezone               String   @default("Europe/Paris")
  modLogChannelId        String?
  staffRoleIds           String[]
  announceChannelId      String? // reçoit /broadcast ; vide = aucune annonce
  xpEnabled              Boolean  @default(true)
  xpMin                  Int      @default(15)
  xpMax                  Int      @default(25)
  xpCooldownSec          Int      @default(60)
  levelUpChannelId       String? // vide = dans le salon du message
  leaderboardPublic      Boolean  @default(true) // page /classement du site
  ticketCategoryId       String?
  ticketStaffRoleIds     String[]
  ticketLogChannelId     String?
  td2ChannelId           String? // raids et incursions
  td2ReportChannelId     String? // signalements reçus, côté staff
  td2ReportViewerRoleIds String[] // rôles autorisés à consulter les signalements
  td2ReportFeedChannelId String? // fil des signalements confirmés du réseau
  td2PublicListing       Boolean  @default(false) // sorties visibles sur la page publique /sorties
  welcomeEnabled         Boolean  @default(false) // message d'arrivée (et rôle d'arrivée) actif
  welcomeChannelId       String? // salon du message d'arrivée ; obligatoire si activé
  welcomeMessage         String? // vide = texte par défaut (WELCOME_DEFAULTS.welcomeMessage)
  welcomeRoleId          String? // rôle donné à chaque nouveau membre, indépendamment du message d'arrivée ; null = aucun
  goodbyeEnabled         Boolean  @default(false) // message de départ actif
  goodbyeChannelId       String? // salon du message de départ ; obligatoire si activé
  goodbyeMessage         String? // vide = texte par défaut (WELCOME_DEFAULTS.goodbyeMessage)
  updatedAt              DateTime @updatedAt
}

// ---------- Accès délégués au tableau de bord ----------
// les onglets du tableau de bord, un par module
enum DashboardModule {
  GENERAL
  LEVELING
  ROLES
  TICKETS
  GIVEAWAYS
  TD2
  WELCOME
  MODERATION
}

// un membre à qui un admin du serveur ouvre certains onglets du site
model GuildDelegate {
  guildId     String
  guild       Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String // ID Discord du membre
  username    String // pseudo au moment de l'ajout, pour l'affichage
  avatar      String? // hash de son avatar Discord
  modules     DashboardModule[]
  grantedById String // l'admin qui a donné l'accès
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@id([guildId, userId])
  @@index([userId])
}

// ---------- Modération ----------
enum CaseType {
  WARN
  MUTE
  UNMUTE
  KICK
  BAN
  UNBAN
}

model Case {
  id          Int       @id @default(autoincrement())
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  number      Int // #1, #2… propre à la guilde
  type        CaseType
  targetId    String
  moderatorId String
  reason      String?
  expiresAt   DateTime? // mute ou ban temporaire
  revokedAt   DateTime? // clearwarn, unban, unmute
  revokedById String?
  createdAt   DateTime  @default(now())

  @@unique([guildId, number])
  @@index([guildId, targetId])
  @@index([guildId, moderatorId]) // filtre « modérateur » de l'onglet Modération
  @@index([guildId, createdAt]) // filtre par période
  @@index([type, expiresAt]) // bans temporaires à lever
}

// ---------- XP et fun ----------
model MemberLevel {
  guildId     String
  userId      String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  xp          Int       @default(0)
  level       Int       @default(0)
  messages    Int       @default(0) // messages qui ont rapporté de l'XP
  lastXpAt    DateTime?
  // copiés à chaque gain : le classement public s'affiche sans appeler Discord
  displayName String?
  avatarUrl   String?

  @@id([guildId, userId])
  @@index([guildId, xp(sort: Desc)])
}

// un seul mariage par membre et par serveur : vérifié dans le service
model Marriage {
  id        Int      @id @default(autoincrement())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user1Id   String // paire triée : user1Id < user2Id
  user2Id   String
  createdAt DateTime @default(now())

  @@unique([guildId, user1Id, user2Id])
  @@index([guildId, user2Id])
}

// ---------- Tickets ----------
enum TicketStatus {
  OPEN
  CLOSED
}

model Ticket {
  id            Int          @id @default(autoincrement())
  guildId       String
  guild         Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  number        Int
  channelId     String       @unique
  ownerId       String
  ownerName     String? // pseudo à l'ouverture, pour la liste du site
  status        TicketStatus @default(OPEN)
  closedById    String?
  closedByName  String?
  messageCount  Int? // messages dans le transcript
  transcriptKey String? // clé S3 du transcript
  createdAt     DateTime     @default(now())
  closedAt      DateTime?

  @@unique([guildId, number])
  @@index([guildId, status])
  @@index([guildId, ownerId, status])
}

/**
 * Le message « Ouvrir un ticket » d'un serveur : un seul par serveur.
 */
model TicketPanel {
  guildId      String    @id
  guild        Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId    String
  messageId    String?   @unique
  title        String
  description  String?
  buttonLabel  String
  // publication : mêmes règles que RolePanel
  publishedAt  DateTime?
  publishError String?
}

// ---------- Giveaways ----------
model Giveaway {
  id             Int             @id @default(autoincrement())
  guildId        String
  guild          Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId      String
  messageId      String?         @unique // vide tant que le bot n'a pas posté
  hostId         String
  prize          String
  winnersCount   Int             @default(1)
  requiredRoleId String?
  endsAt         DateTime
  endedAt        DateTime? // tirage fait : les gagnants sont dans winnerIds
  winnerIds      String[]
  announcedAt    DateTime? // message final et félicitations envoyés
  // publication du message : mêmes règles que les panels
  publishedAt    DateTime?
  publishError   String?
  entries        GiveawayEntry[]
  createdAt      DateTime        @default(now())

  @@index([guildId, endedAt])
}

model GiveawayEntry {
  giveawayId  Int
  userId      String
  displayName String? // pseudo à l'inscription, pour afficher les gagnants sur le site
  giveaway    Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([giveawayId, userId])
}

// ---------- Autorole (panels de boutons) ----------
enum RolePanelMode {
  MULTIPLE // plusieurs rôles possibles
  UNIQUE // un seul rôle à la fois
}

model RolePanel {
  id           Int               @id @default(autoincrement())
  guildId      String
  guild        Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId    String
  messageId    String?           @unique
  title        String
  description  String?
  mode         RolePanelMode     @default(MULTIPLE)
  options      RolePanelOption[]
  // publication : le site remet les deux à null, le bot remplit l'un ou l'autre
  publishedAt  DateTime?
  publishError String?
  createdAt    DateTime          @default(now())

  @@index([guildId])
}

model RolePanelOption {
  id       Int       @id @default(autoincrement())
  panelId  Int
  panel    RolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  roleId   String
  label    String
  emoji    String?
  position Int       @default(0)
}

// ---------- The Division 2 ----------
// mêmes plateformes que l'API tracker.gg (ubi, psn, xbl)
enum Td2Platform {
  UBI
  PSN
  XBL
}

enum Td2ActivityKind {
  RAID
  INCURSION
}

enum Td2Role {
  DPS
  HEAL
  TANK
  HEAL_TANK // build hybride des incursions
  PLAYER // missions : une place, sans rôle
}

// difficulté d'une mission, comme dans le jeu
enum Td2Difficulty {
  NORMAL
  HARD
  CHALLENGING
  HEROIC
  LEGENDARY
}

enum Td2SignupStatus {
  CONFIRMED
  RESERVE // rôle complet : en attente d'une place
}

enum Td2ReportStatus {
  PENDING // affiché « non vérifié » hors du serveur d'origine
  IN_REVIEW
  CONFIRMED
  REJECTED // jamais visible hors du serveur d'origine
}

// profil lié par /td2 link, commun à tous les serveurs
model Td2Profile {
  userId     String      @id // ID Discord
  platform   Td2Platform
  playerName String
  linkedAt   DateTime    @default(now())
}

// catalogue global, géré par le propriétaire du bot : Dark Hours, Paradis Perdu…
model Td2Activity {
  id     Int               @id @default(autoincrement())
  kind   Td2ActivityKind
  name   String
  active Boolean           @default(true)
  modes  Td2ActivityMode[]

  @@unique([kind, name])
}

// un mode = une composition : Normal, Semi-Speed…
model Td2ActivityMode {
  id         Int           @id @default(autoincrement())
  activityId Int
  activity   Td2Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name       String
  slots      Td2ModeSlot[]
  events     Td2Event[]

  @@unique([activityId, name])
}

// nombre de places par rôle pour un mode
model Td2ModeSlot {
  modeId Int
  role   Td2Role
  count  Int
  mode   Td2ActivityMode @relation(fields: [modeId], references: [id], onDelete: Cascade)

  @@id([modeId, role])
}

// directives : les règles qui durcissent une mission, gérées par le propriétaire du bot
model Td2Directive {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  active      Boolean @default(true)
}

model Td2Event {
  id          Int              @id @default(autoincrement())
  guildId     String
  guild       Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  // null pour une mission ; Restrict : supprimer un mode ne change pas un raid en mission
  modeId      Int?
  mode        Td2ActivityMode? @relation(fields: [modeId], references: [id], onDelete: Restrict)
  missionName String? // mission : le nom choisi par l'organisateur
  difficulty  Td2Difficulty? // mission : sa difficulté
  directives  String[]         @default([]) // mission : noms des directives, copiés à la création
  scheduledAt DateTime
  channelId   String
  messageId   String?          @unique
  organizerId String
  cancelledAt DateTime?
  slots       Td2EventSlot[] // composition copiée du mode à la création
  signups     Td2Signup[]
  createdAt   DateTime         @default(now())
}

model Td2EventSlot {
  eventId Int
  role    Td2Role
  count   Int
  event   Td2Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, role])
}

model Td2Signup {
  eventId   Int
  userId    String
  role      Td2Role
  status    Td2SignupStatus @default(CONFIRMED)
  event     Td2Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now()) // ordre de passage de la réserve

  @@id([eventId, userId])
}

// signalement partagé entre tous les serveurs du bot
model Td2Report {
  id              Int             @id @default(autoincrement())
  guildId         String // serveur d'origine
  guild           Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  reporterId      String // visible du seul staff d'origine
  playerName      String // pseudo tel que saisi
  playerNameLower String // pour les recherches
  platform        Td2Platform
  reason          String
  details         String?
  evidenceKeys    String[] // clés S3 des preuves, au moins une pour confirmer
  status          Td2ReportStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  staffMessageId  String?         @unique // embed dans le salon staff d'origine
  createdAt       DateTime        @default(now())

  @@index([platform, playerNameLower])
  @@index([guildId, status])
}

// ---------- Forum (unique, pour tout le site) ----------
model ForumCategory {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  name        String
  description String?
  position    Int           @default(0)
  threads     ForumThread[]
}

model ForumThread {
  id         Int           @id @default(autoincrement())
  categoryId Int
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  title      String
  pinned     Boolean       @default(false)
  locked     Boolean       @default(false)
  posts      ForumPost[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt // dernière activité : une réponse le fait avancer

  // La liste d'une catégorie : épinglés d'abord, puis du plus récent au plus ancien
  @@index([categoryId, pinned, updatedAt])
}

// image du forum, ré-encodée en WebP et rangée dans le bucket media
model ForumAttachment {
  id         String     @id @default(uuid())
  postId     Int? // vide tant que le message n'est pas publié
  post       ForumPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User       @relation(fields: [uploaderId], references: [id])
  key        String     @unique // clé dans le bucket media
  sizeBytes  Int
  width      Int
  height     Int
  createdAt  DateTime   @default(now())

  @@index([postId])
}

model ForumPost {
  id          Int               @id @default(autoincrement())
  threadId    Int
  thread      ForumThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId    String
  author      User              @relation(fields: [authorId], references: [id])
  content     String
  attachments ForumAttachment[]
  editedAt    DateTime?
  createdAt   DateTime          @default(now())

  // Les messages d'un sujet, dans l'ordre
  @@index([threadId, createdAt])
}

// ---------- Métriques des propriétaires du bot (phase 11) ----------

/// L'utilisation des commandes, heure par heure : la commande et le serveur, jamais le membre.
model CommandUsage {
  hour            DateTime // début de l'heure, en UTC
  /// '' : hors serveur (message privé). Pas de clé étrangère : un serveur quitté garde son historique
  guildId         String
  /// Avec la sous-commande : « td2 mission »
  command         String
  count           Int      @default(0)
  errors          Int      @default(0)
  totalDurationMs Int      @default(0)

  @@id([hour, guildId, command])
  @@index([hour])
}

/// Un relevé (CPU, RAM, stockage) toutes les 5 minutes, effacé après 30 jours.
model MetricSample {
  /// bot.cpu, api.memory, postgres.bytes, garage.media.objects…
  name    String
  /// Aligné sur le créneau de 5 minutes : deux écritures du même créneau n'en font qu'une
  takenAt DateTime
  value   Float

  @@id([name, takenAt])
  @@index([takenAt])
}
