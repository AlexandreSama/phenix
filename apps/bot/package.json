{
  "name": "@phenix/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsdown",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "deploy-commands": "tsx --env-file-if-exists=../../.env src/scripts/deploy-commands.ts",
    "td2:record": "tsx --env-file-if-exists=../../.env src/scripts/record-td2-profile.ts"
  },
  "dependencies": {
    "@phenix/database": "workspace:*",
    "@phenix/shared": "workspace:*",
    "@phenix/storage": "workspace:*",
    "@phenix/jobs": "workspace:*",
    "discord.js": "^14.28.1",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@phenix/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "pino-pretty": "^13.2.0",
    "tsdown": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
