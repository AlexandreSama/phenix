# Copie ce fichier en .env et remplis les valeurs. Ne versionne jamais .env.

# Postgres (docker-compose.dev.yml)
POSTGRES_USER=projet
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=projet
DATABASE_URL=postgresql://projet:change-moi@localhost:5432/projet

# Valkey (compatible Redis)
REDIS_URL=redis://localhost:6379

# tracker.gg (phase 7.3) : clé créée sur tracker.gg/developers. Vide = /td2 stats désactivée
TRN_API_KEY=
# Adresse de l'API de stats. Vide = celle de tracker.gg
TRN_API_URL=

# Bot Discord (portail développeur)
NODE_ENV=development
LOG_LEVEL=info
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_DEV_GUILD_ID=
BOT_OWNER_IDS=

# API et site (phase 4)
API_PORT=
# Adresse du site : retour OAuth2 pour l'API, lien « Classement complet » pour le bot (phase 5)
PUBLIC_URL=
DISCORD_CLIENT_SECRET=

# Garage, stockage S3 des transcripts (phase 6.2)
# Secret entre les nœuds Garage : openssl rand -hex 32
GARAGE_RPC_SECRET=
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
# Clé créée par « garage key create » : l'ID commence par GK
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_TRANSCRIPTS_BUCKET=transcripts
# Images du forum (phase 8) : ré-encodées en WebP par l'API, servies sur /api/media/…
S3_MEDIA_BUCKET=media
# API d'administration de Garage (phase 11) : le bot y lit le volume de chaque bucket.
# Jeton : openssl rand -hex 32. Vide = pas de relevé Garage sur la page Métriques
GARAGE_ADMIN_TOKEN=
GARAGE_ADMIN_URL=http://localhost:3903

# Métriques (phase 11) : la version affichée sur la page Métriques (un SHA git, par exemple).
# Vide = « dev »
APP_VERSION=