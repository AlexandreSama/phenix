{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "vitest/require-mock-type-parameters": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_count", "_max"]
      }
    ]
  },
  "ignorePatterns": ["**/dist/**", "**/src/generated/**", "**/coverage/**"]
}
